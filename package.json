{
  "name": "dawnexus-social",
  "version": "1.0.0",
  "description": "Dawnexus Social — Unified Multi-Tenant Social Media Management & MCP SaaS Platform",
  "type": "module",
  "main": "server/index.ts",
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"magenta,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --port 3005 --host",
    "build": "vite build",
    "start": "tsx server/index.ts"
  },
  "keywords": [
    "dawnexus",
    "social",
    "mcp",
    "social-media-management",
    "meta-ads",
    "ai-assistant"
  ],
  "author": "Dawnexus",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
